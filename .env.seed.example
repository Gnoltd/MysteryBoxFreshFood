# Copy this file to .env.seed and fill in your values from the service account JSON.
# Get the JSON from: Firebase Console → Project Settings → Service accounts → Generate new private key

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQE...(your key)...\n-----END PRIVATE KEY-----\n"

# These are the credentials that will be created in Firebase Auth:
# Vendor:   admin@gmail.com  /  admin123
# Customer: customer1@gmail.com  /  pass123456  (customer1 through customer5)
